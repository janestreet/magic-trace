opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://magic-trace.org"
bug-reports: "https://github.com/janestreet/magic-trace/issues"
dev-repo: "git+https://github.com/janestreet/magic-trace.git"
doc: "https://github.com/janestreet/magic-trace/wiki"
license: "MIT"
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml"        {>= "4.14"}
  "ocamlformat"  {with-test}
  "ocaml_intrinsics"
  "async"
  "camlzip"
  "cohttp"
  "cohttp_static_handler"
  "core"
  "core_unix"
  "expect_test_helpers_async"
  "crunch"
  "ppx_jane"
  "shell"
  "dune"         {>= "2.0.0"}
  "owee"         {>= "0.8"}
  "re"           {>= "1.8.0"}
  "zstandard"
  "vec"
  "lwt"
  "lwt_unix"
  "mirage-crypto"
  "mirage-crypto-rng"
  "mirage-crypto-rng-unix"
  "mirage-crypto-ec"
  "kdf"
  "cstruct"
  "msgpck"
  "base64"
  "tls-lwt"
  "ca-certs"
  "digestif"
]
depexts: [
  ["gmp"] {os-distribution = "homebrew"}
  ["pkgconf"] {os-distribution = "homebrew"}
  ["gmp-dev"] {os-family = "alpine"}
  ["libgmp-dev"] {os-family = "debian"}
  ["gmp-devel"] {os-family = "rhel"}
]
synopsis: "Collects and displays high-resolution traces of what a process is doing"
description: "https://github.com/janestreet/magic-trace"
